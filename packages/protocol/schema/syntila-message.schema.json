{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conclaveax.com/schemas/syntila-message.schema.json",
  "title": "Syntila current shared runtime contracts",
  "description": "Execution error taxonomy, Worker Agent protocol metadata, and realtime event metadata.",
  "x-execution-error-codes": [
    "worker_not_ready",
    "cli_not_found",
    "authentication_required",
    "unsupported_cli_version",
    "model_not_supported",
    "permission_denied",
    "space_folder_exists",
    "quota_exhausted",
    "provider_unavailable",
    "timeout",
    "cancelled",
    "execution_failed",
    "context_limit_exceeded",
    "additional_folders_unsupported",
    "worker_offline"
  ],
  "x-execution-error-messages": {
    "worker_not_ready": "The selected Worker is not ready.",
    "cli_not_found": "The required local CLI could not be found.",
    "authentication_required": "Sign in to the configured provider on this computer.",
    "unsupported_cli_version": "The installed local CLI version is not supported.",
    "model_not_supported": "The selected model is not supported by this Worker.",
    "permission_denied": "A local permission required for this assignment was denied.",
    "space_folder_exists": "A folder with this Space's name already exists on this computer and is not empty. Confirm to use it.",
    "quota_exhausted": "The provider's usage limit has been reached.",
    "provider_unavailable": "The provider is temporarily unavailable.",
    "timeout": "The assignment exceeded its time limit.",
    "cancelled": "The assignment was cancelled.",
    "execution_failed": "The assignment could not be completed.",
    "context_limit_exceeded": "This conversation exceeds the supported context limit. Clear AI History and retry; the latest answer is kept as context.",
    "additional_folders_unsupported": "This Worker cannot use the Space's additional folders yet. Detach the additional folders or choose another Worker.",
    "worker_offline": "The selected Worker is offline. Start its Agent and try again."
  },
  "x-worker-agent-protocol": {
    "name": "syntila.worker-agent-protocol",
    "version": "5.1",
    "maxMessageSizeBytes": 4194304,
    "messageTypes": [
      "agent.hello",
      "agent.hello.ack",
      "agent.heartbeat",
      "agent.heartbeat.ack",
      "agent.sync.request",
      "agent.sync.result",
      "agent.status",
      "agent.readiness",
      "agent.update",
      "worker.inventory",
      "thread.status",
      "assignment.start",
      "assignment.start.ack",
      "assignment.startup",
      "assignment.start.permit.request",
      "assignment.start.permit.grant",
      "assignment.ack",
      "assignment.activity",
      "assignment.result",
      "assignment.error",
      "assignment.cancel",
      "assignment.cancel.ack",
      "assignment.cancelled",
      "diagnostic.probe",
      "diagnostic.probe.ack",
      "worker.usage.request",
      "worker.usage.result",
      "mcp.tool_call.request",
      "mcp.tool_call.result",
      "mcp.tool_call.status.request",
      "mcp.tool_call.status.result",
      "mcp.inventory",
      "input.available"
    ],
    "baseEnvelopeFields": [
      "protocol",
      "protocolVersion",
      "messageId",
      "correlationId",
      "timestamp",
      "type",
      "payload"
    ],
    "assignmentEnvelopeFields": [
      "workerId",
      "runId",
      "taskId",
      "attemptId",
      "assignmentId",
      "idempotencyKey"
    ]
  },
  "x-realtime-events": {
    "name": "syntila.realtime-events",
    "version": "1.1",
    "envelopeFields": [
      "eventId",
      "type",
      "version",
      "timestamp",
      "sequence",
      "payload"
    ],
    "optionalEnvelopeFields": [
      "spaceId",
      "runId",
      "taskId",
      "assignmentId",
      "threadId",
      "attemptId",
      "stream"
    ],
    "durableTypes": [
      "work_request.created",
      "work_request.started",
      "work_request.input_updated",
      "work_request.completed",
      "work_request.failed",
      "work_request.cancelled",
      "step.queued",
      "step.running",
      "step.completed",
      "step.failed",
      "step.cancelled",
      "step.phase",
      "run.started",
      "run.paused",
      "run.resumed",
      "run.completed",
      "run.failed",
      "assignment.accepted",
      "assignment.completed",
      "assignment.failed",
      "assignment.cancelled",
      "artifact.created",
      "space.created",
      "space.updated",
      "space.archived",
      "space.deleted",
      "thread.created",
      "thread.updated",
      "thread.deleted",
      "thread.work_cleared",
      "thread.chat_cleared",
      "thread.queue_updated",
      "thread.read",
      "discussion.created",
      "discussion.updated",
      "discussion.deleted",
      "people.updated"
    ],
    "ephemeralTypes": [
      "assignment.activity",
      "stream.delta",
      "tool.invocation.status",
      "heartbeat"
    ],
    "streamKinds": ["space", "user", "thread", "worker_inbox", "assignment"],
    "collaborationTypes": [
      "space.created",
      "space.updated",
      "space.archived",
      "space.deleted",
      "thread.created",
      "thread.updated",
      "thread.deleted",
      "thread.work_cleared",
      "thread.chat_cleared",
      "thread.queue_updated",
      "thread.read",
      "discussion.created",
      "discussion.updated",
      "discussion.deleted",
      "people.updated"
    ]
  },
  "x-execution-events": {
    "protocol": "syntila.execution-events",
    "protocolVersion": "1.0",
    "schemaVersion": 1,
    "identityFields": [
      "threadId",
      "workRequestId",
      "runId",
      "taskId",
      "assignmentId",
      "attemptId",
      "executionId",
      "workerId"
    ],
    "sequenceMeaning": "source execution sequence; Cloud realtime cursors are separate",
    "categories": ["activity", "lifecycle"],
    "deliveries": ["ephemeral", "replayable", "terminal"]
  },
  "x-provider-failure": {
    "schemaVersion": 1,
    "sources": ["structured_error", "result_message", "stderr", "stdout", "plugin"],
    "omittableFields": ["nativeErrorCode", "providerErrorText", "failedRunResponse"],
    "limits": {
      "maxNativeErrorCodeBytes": 128,
      "maxProviderErrorTextBytes": 4096,
      "maxFailedRunResponseBytes": 32768,
      "maxTotalBytes": 40960
    }
  }
}
