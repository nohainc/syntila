{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Syntila auth Worker: Better Auth, desktop sign-in, backend tokens and the
  // email relay. The product API runs on the VPS backend (SYNTILA_BACKEND_URL).
  "name": "syntila-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    // Daily: prune ended auth sessions.
    "crons": ["17 3 * * *"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "send_email": [
    {
      "name": "SYNTILA_EMAIL",
      "remote": true,
    },
  ],
  "vars": {
    "SYNTILA_PROFILE_LAB_OWNER_EMAIL": "vitalii@nohainc.com",
    "SYNTILA_ENVIRONMENT": "development",
    "SYNTILA_BACKEND_URL": "https://api.syntila.app",
    // Optional social sign-in; empty disables a provider. Declared here so
    // wrangler loads overrides from .dev.vars (with `secrets` configured it
    // only loads .dev.vars keys that are declared vars or required secrets).
    "SYNTILA_AUTH_GITHUB_CLIENT_ID": "",
    "SYNTILA_AUTH_GITHUB_CLIENT_SECRET": "",
    "SYNTILA_AUTH_GOOGLE_CLIENT_ID": "",
    "SYNTILA_AUTH_GOOGLE_CLIENT_SECRET": "",
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      // Private Ed25519 JWK; the VPS holds the public half in /etc/syntila/auth-public-keys.
      "SYNTILA_BACKEND_SIGNING_KEY",
      // Shared with the backend (EMAIL_RELAY_SECRET in /etc/syntila/backend.env).
      "EMAIL_RELAY_SECRET",
    ],
  },
  "d1_databases": [
    {
      "binding": "SYNTILA_DB",
      // Auth-only database; product data lives in the backend's PostgreSQL.
      "database_name": "syntila-auth-development",
      "database_id": "local",
      "migrations_dir": "migrations",
    },
  ],
  "migrations": [
    {
      "tag": "v3-workspace-gateway",
      "new_sqlite_classes": ["WorkspaceGateway"],
    },
    {
      "tag": "v2-realtime-gateway",
      "new_sqlite_classes": ["RealtimeGateway"],
    },
    {
      "tag": "v6-thread-coordinator",
      "new_sqlite_classes": ["ThreadExecutionCoordinator"],
    },
    {
      // The gateways and coordinator now run in the VPS backend.
      "tag": "v7-moved-to-vps",
      "deleted_classes": ["WorkspaceGateway", "RealtimeGateway", "ThreadExecutionCoordinator"],
    },
  ],
}
