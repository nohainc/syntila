{
  // Type check only (bun runs the sources directly): `bun run typecheck`.
  // Bun's own types (@types/bun) are not installed yet; their absence is in
  // scripts/typecheck-baseline.json and disappears once they are added.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "strict": false
  },
  "include": ["src/**/*.ts", "../cloud/worker-configuration.d.ts"]
}
