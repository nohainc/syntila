{
  // Type check only (bun runs the sources directly): `bun run typecheck`.
  // Bun's own types come from @types/bun (devDependency).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "bun"],
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "strict": false
  },
  "include": ["src/**/*.ts", "../cloud/worker-configuration.d.ts"]
}
