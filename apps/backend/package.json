{
  "name": "@syntila/backend",
  "version": "0.6.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "start": "bun run src/server.ts",
    "migrate": "bun run src/migrate.ts",
    "migrate:status": "bun run src/migrate.ts --dry-run",
    "schema:verify": "bun run src/migrate.ts --verify",
    "schema:lock": "bun run src/migrate.ts --print-lock > migrations/schema.lock",
    "routes": "bun scripts/routes.ts --write",
    "write-paths": "bun scripts/write-paths.ts --write",
    "dup-statements": "bun scripts/dup-statements.ts",
    "build": "bash scripts/build.sh",
    "test": "bun scripts/test.ts"
  },
  "dependencies": {
    "@syntila/core": "workspace:*",
    "@syntila/protocol": "workspace:*",
    "@syntila/security": "workspace:*",
    "@syntila/tool-profile": "workspace:*",
    "@syntila/workspace-runtime-protocol": "workspace:*"
  }
}
