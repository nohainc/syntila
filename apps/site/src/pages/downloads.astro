---
import Container from "../components/Container.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { connectRelease } from "../data/connect-release";
---

<SiteLayout
  title="Install — Syntila"
  description="Download Syntila Connect for macOS, Windows, or Linux to connect your computer and its AI tools to a Syntila Space. Members can join a Space on the web or mobile."
>
  <Section>
    <Container>
      <SectionHeader
        eyebrow="Install"
        title="Run Syntila Workers on your computer."
        description="Install Syntila Connect on the computer that will run your AI tools. Then access your Spaces from the web or mobile, including from another location. Keep that computer awake and online for its Workers to answer."
        headingLevel={1}
      />

      <div class="security-callout downloads-joining">
        <strong>Just joining a Space? You do not need to install anything.</strong>
        <span>Open <a href="https://app.syntila.app" data-site-event="cta.open_app">app.syntila.app</a> in a browser or use the iOS or Android app.</span>
      </div>

      <p class="downloads-release-version">{connectRelease.productName}</p>
      <div class="downloads-grid" data-downloads-platforms data-site-event="section.downloads_reached">
        {connectRelease.targets.map((target) => (
          <article class="downloads-card" data-platform={target.platform}>
            <div class="downloads-card__header">
              <div class="downloads-card__identity">
                <span class="downloads-platform-icon" aria-hidden="true">
                  <img src={`/icons/platforms/${target.platform}.svg`} alt="" />
                </span>
                <div><h2>{target.label}</h2>
                <p>{target.architectures.join(" / ")}</p></div>
              </div>
              <span class="badge downloads-card__recommended" hidden>Your system</span>
            </div>
            <a class="button button--primary" href={target.downloadUrl} target="_blank" rel="noreferrer" data-site-event="cta.download">Download for {target.label} <span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>

      <div class="downloads-cli-section">
        <SectionHeader
          eyebrow="Setup"
          title="Connect your computer."
          description="After installation, pair a Worker with Connect on this computer."
        />
        <div class="downloads-cli-grid">
          <div class="downloads-cli-box">
            <h3>Pair a Worker</h3>
            <p>Create a Worker on the Workers page and use its pairing code with Connect. Keep the code private.</p>
            <pre><code>syntila-connect pair --pairing-code-stdin</code></pre>
          </div>
          <div class="downloads-cli-box">
            <h3>Run and check the Worker</h3>
            <p>Start the installed per-user service and check its status. Automatic startup is optional. If you have more than one Worker, add <code>--worker ID</code> to select it.</p>
            <pre><code>syntila-connect service start
syntila-connect service status</code></pre>
          </div>
          <div class="downloads-cli-box">
            <h3>Prepare your AI tools</h3>
            <p>Install and sign in to the provider CLI required by the Worker's signed Profile on this computer.</p>
          </div>
        </div>
      </div>
    </Container>
  </Section>
</SiteLayout>

<script src="/scripts/downloads-platform.js" defer></script>
<script src="/scripts/copy-commands.js" defer></script>
