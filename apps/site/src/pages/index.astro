---
import SiteLayout from "../layouts/SiteLayout.astro";
import Button from "../components/Button.astro";
import Container from "../components/Container.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import HeroSharedSpace from "../components/HeroSharedSpace.astro";
import SpaceMembersDiagram from "../components/SpaceMembersDiagram.astro";
import CredentialPrivacyDiagram from "../components/CredentialPrivacyDiagram.astro";
import ConversationContinuity from "../components/ConversationContinuity.astro";
import ComparisonTable from "../components/ComparisonTable.astro";
import WorkflowShowcase from "../components/WorkflowShowcase.astro";
import AudienceCards from "../components/AudienceCards.astro";
import WorkspaceQuickstart from "../components/WorkspaceQuickstart.astro";
---

<SiteLayout
  title="Syntila — Bring your people and AI together"
  description="Syntila gives families, friends, and teams one shared place to collaborate with AI. Create spaces, share AI access without sharing credentials, and keep conversations in context."
>
  <!-- Hero Section -->
  <Container>
    <section class="hero" id="product">
      <div>
        <div class="eyebrow">SHARED AI WORKSPACE</div>
        <h1>Bring your people and AI together.</h1>
        <p class="lede">
          Collaborate with family, friends, and teammates in shared Spaces and Threads in the Syntila app across web, iOS, and Android. Members connect a Syntila Workspace to make their AI Workers available to the group while keeping provider credentials private on their own machines.
        </p>
        <div class="actions">
          <Button href="https://syntila.app" label="Open Syntila" event="cta.open_app" />
          <Button href="/how-it-works/" label="See how it works" variant="secondary" event="navigation.how_it_works" />
        </div>

        <ul class="trust-value-strip" role="list">
          <li class="trust-item">
            <span class="trust-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            </span>
            <span>Shared Spaces & Threads</span>
          </li>
          <li class="trust-item">
            <span class="trust-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3L12 3z"/></svg>
            </span>
            <span>Shared AI access</span>
          </li>
          <li class="trust-item">
            <span class="trust-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="11" x="3" y="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </span>
            <span>Private local credentials</span>
          </li>
          <li class="trust-item">
            <span class="trust-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            </span>
            <span>Message or Ask AI</span>
          </li>
          <li class="trust-item">
            <span class="trust-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
            </span>
            <span>Choose any authorized Worker</span>
          </li>
          <li class="trust-item">
            <span class="trust-icon" aria-hidden="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 21h5v-5"/></svg>
            </span>
            <span>Multi-step Work presets</span>
          </li>
        </ul>
      </div>
      <HeroSharedSpace />
    </section>
  </Container>

  <!-- Section 1: Mental Model - One space. Your people. Their AI. -->
  <Section>
    <Container>
      <SectionHeader
        eyebrow="ONE SPACE. PEOPLE + AI."
        title="One space. Your people. Their AI."
        description="Not everyone needs to install tools or manage subscriptions. One or more members connect a Syntila Workspace and grant selected AI Workers to the Space, so every invited member can collaborate in Syntila across web, iOS, and Android."
      />
      <SpaceMembersDiagram />
    </Container>
  </Section>

  <!-- Section 2: Collaborative Conversations -->
  <Section>
    <Container>
      <div class="split-section split-section--reversed">
        <div>
          <SectionHeader
            eyebrow="COLLABORATION IN CONTEXT"
            title="One conversation. Everyone stays in context."
            description="AI stops being an isolated chat between one person and a bot. In Syntila, everyone in the Space sees the human discussion, the AI prompt, the response, and the decisions being made."
          />
          <ul class="feature-bullets" role="list">
            <li class="bullet-item">
              <strong>Choose the right Worker per request</strong>
              <p>Select ChatGPT, Claude, Gemini, or a coding agent for the next turn in the same Thread. Syntila carries the conversation history forward automatically.</p>
            </li>
            <li class="bullet-item">
              <strong>Shared turn history</strong>
              <p>Every turn retains attribution, structured outputs, code blocks, and decisions so your group iterates together without copy-pasting between separate chat apps.</p>
            </li>
          </ul>
        </div>
        <ConversationContinuity />
      </div>
    </Container>
  </Section>

  <!-- Section 3: Share Access. Keep Credentials Private -->
  <Section>
    <Container>
      <SectionHeader
        eyebrow="CREDENTIALS STAY PRIVATE"
        title="Share access. Keep credentials private."
        description="When you grant a Workspace and its AI Workers to a Space, members can run requests through those Workers for Space work, while your provider logins and API keys stay inside the local CLI on your machine."
      />
      <CredentialPrivacyDiagram />
    </Container>
  </Section>

  <!-- Section 5: Comparison - Why not normal AI chat? -->
  <Section>
    <Container>
      <SectionHeader
        eyebrow="THE COLLABORATION DIFFERENCE"
        title="AI chat was designed for one person. Syntila is designed for a group."
        description="Traditional AI chatbots trap prompts, answers, and subscriptions in isolated solo sessions. Syntila creates a shared collaboration layer where groups think, execute, and decide together."
      />
      <ComparisonTable />
    </Container>
  </Section>

  <!-- Section 6: Advanced Workflows -->
  <Section>
    <Container>
      <SectionHeader
        eyebrow="ADVANCED WORKFLOWS"
        title="When a chat isn't enough: Turn a question into a workflow."
        description="When a task needs more than a single Chat reply, choose Work, Research, or Implement to coordinate multiple AI Workers, plan steps, and verify findings in one Thread."
      />
      <WorkflowShowcase />
    </Container>
  </Section>

  <!-- Section 7: Who It's For -->
  <Section id="use-cases">
    <Container>
      <SectionHeader
        eyebrow="BUILT FOR EVERY GROUP"
        title="Designed for how people actually collaborate."
        description="Whether you're organizing a family trip, leading product decisions with your team, or shipping verified code, Syntila brings people and AI into one shared workspace."
      />
      <AudienceCards />
    </Container>
  </Section>

  <!-- Section 8: Syntila Workspace Execution Model -->
  <Section>
    <Container>
      <div data-site-event="section.workspace_reached">
        <SectionHeader
          eyebrow="SYNTILA WORKSPACE RUNTIME"
          title="Collaborate in Syntila. Execute on connected Workspaces."
          description="People join Spaces and Threads in the Syntila app at syntila.app across web, iOS, and Android. To power AI Workers in a Space, at least one member connects Syntila Workspace on macOS, Windows, or Linux and grants selected Workers to that Space."
        />
        <div class="section-block-gap">
          <WorkspaceQuickstart />
        </div>
      </div>
    </Container>
  </Section>

  <!-- Final CTA Section -->
  <Section class="final-cta-section">
    <Container>
      <div class="final-cta">
        <SectionHeader
          eyebrow="AI IS BETTER TOGETHER"
          title="Bring your people and AI together."
          description="Open Syntila on web or mobile, create a Space, and connect a Syntila Workspace to start collaborating with your people and AI."
        />
        <div class="final-cta__actions">
          <Button href="https://syntila.app" label="Open Syntila" event="cta.open_app" />
          <Button href="/downloads/" label="Download Workspace" variant="secondary" />
        </div>
      </div>
    </Container>
  </Section>
</SiteLayout>
