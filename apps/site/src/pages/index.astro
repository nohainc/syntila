---
import SiteLayout from "../layouts/SiteLayout.astro";
import Button from "../components/Button.astro";
import Container from "../components/Container.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import SpaceMembersDiagram from "../components/SpaceMembersDiagram.astro";
import WorkflowShowcase from "../components/WorkflowShowcase.astro";
import AudienceCards from "../components/AudienceCards.astro";
import PlansOverview from "../components/PlansOverview.astro";
---

<SiteLayout
  title="Syntila — Bring your projects, people, and AI together"
  description="Work on personal projects or collaborate with others using your AI tools in Syntila. Access your Spaces on the web or mobile."
>
  <!-- Hero -->
  <Container>
    <section class="hero hero--stacked">
      <div class="hero__copy">
        <h1>Bring your projects, people, and AI together.</h1>
        <p class="lede">
          Work on your own projects or bring family, friends, and teammates together. Connect your AI tools and access your Spaces on the web or mobile, wherever you are.
        </p>
      </div>

      <div class="final-cta hero-cta">
        <SectionHeader
          eyebrow="AI IS BETTER TOGETHER"
          title="Start with one Space."
          description="Create a Space for yourself or your group, and connect a computer to power its AI Workers."
        />
        <div class="final-cta__actions">
          <Button href="https://app.syntila.app" label="Open Syntila" event="cta.open_app" />
          <Button href="/downloads/" label="Install Workspace" variant="secondary" event="navigation.downloads" />
        </div>
      </div>
    </section>
  </Container>

  <!-- How the pieces fit -->
  <Section>
    <Container>
      <SectionHeader
        eyebrow="ONE SPACE. PEOPLE + AI."
        title="Your projects and AI, together in one Space."
        description="Keep each topic in a Thread and ask AI Workers with the conversation as context. Work on your own or invite others; a connected computer powers the Workers."
      />
      <SpaceMembersDiagram />
    </Container>
  </Section>

  <!-- Workflows -->
  <Section>
    <Container>
      <SectionHeader
        eyebrow="FOUR WAYS TO ASK"
        title="When a chat isn't enough: turn a question into a workflow."
        description="Most requests are a quick Chat. When you need more, choose a workflow that does the work, splits it across Workers, or checks its own result."
      />
      <WorkflowShowcase illustrated />
    </Container>
  </Section>

  <!-- Audiences -->
  <Section id="use-cases">
    <Container>
      <SectionHeader
        eyebrow="BUILT FOR YOUR WORK"
        title="Made for your projects and your people."
        description="Build a personal project, plan a family trip, or work through a team decision."
      />
      <AudienceCards />
    </Container>
  </Section>

  <!-- Plans -->
  <Section id="plans">
    <Container>
      <SectionHeader
        eyebrow="PLANS"
        title="Free to start."
        description="Syntila does not sell AI usage. Workers run on AI tools that members already have, so what you pay your AI provider stays between you and them."
      />
      <PlansOverview />
    </Container>
  </Section>


</SiteLayout>
