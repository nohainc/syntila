---
import SiteLayout from "../layouts/SiteLayout.astro";
import Button from "../components/Button.astro";
import Container from "../components/Container.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import HeroSharedSpace from "../components/HeroSharedSpace.astro";
import SpaceMembersDiagram from "../components/SpaceMembersDiagram.astro";
import ConversationContinuity from "../components/ConversationContinuity.astro";
import ComparisonTable from "../components/ComparisonTable.astro";
import WorkflowShowcase from "../components/WorkflowShowcase.astro";
import AudienceCards from "../components/AudienceCards.astro";
import PlansOverview from "../components/PlansOverview.astro";
---

<SiteLayout
  title="Syntila — Bring your people and AI together"
  description="Syntila gives families, friends, and teams one shared place to talk with each other and with AI. Create Spaces, invite your people, and keep every conversation in context."
>
  <!-- Hero -->
  <Container>
    <section class="hero hero--stacked">
      <div class="hero__copy">
        <h1>Bring your people and AI together.</h1>
        <p class="lede">
          Syntila is a shared space where family, friends, and teammates talk with each other and with AI in the same conversation. One person connects a computer and the AI tools already on it. Everyone else just opens the app.
        </p>
        <div class="actions">
          <Button href="https://syntila.app" label="Open Syntila" event="cta.open_app" />
          <Button href="/how-it-works/" label="See how it works" variant="secondary" event="navigation.how_it_works" />
        </div>
      </div>

      <figure class="hero-visual">
        <div class="hero-visual__frame" role="img" aria-label="Illustration of a Syntila Space called Family Vacation: three members discuss a trip in a shared Thread and get answers from ChatGPT and Gemini, each running on a member's own computer.">
          <HeroSharedSpace />
        </div>
        <figcaption>Illustration of a shared Thread. Names and content are examples.</figcaption>
      </figure>
    </section>
  </Container>

  <!-- How the pieces fit -->
  <Section>
    <Container>
      <SectionHeader
        eyebrow="ONE SPACE. PEOPLE + AI."
        title="One space. Your people. Their AI."
        description="One member sets things up: they install Syntila Workspace on their computer and choose which AI Workers the Space may use. Everyone else joins from a browser, with nothing to install and no AI account of their own."
      />
      <SpaceMembersDiagram />
    </Container>
  </Section>

  <!-- Collaborative conversations -->
  <Section>
    <Container>
      <div class="split-section split-section--reversed">
        <div>
          <SectionHeader
            eyebrow="COLLABORATION IN CONTEXT"
            title="One conversation. Everyone stays in context."
            description="Everyone in the Space sees the discussion, the question put to the AI, the answer, and what the group decided. Nobody has to forward screenshots."
          />
          <ul class="feature-bullets" role="list">
            <li class="bullet-item">
              <strong>Pick the Worker for each request</strong>
              <p>Ask ChatGPT, then Claude, then Gemini in the same Thread. Syntila carries the conversation forward, so nobody repeats the background.</p>
            </li>
            <li class="bullet-item">
              <strong>Shared history</strong>
              <p>Every turn shows who asked, which Worker answered, and what came back.</p>
            </li>
          </ul>
        </div>
        <ConversationContinuity />
      </div>
    </Container>
  </Section>

  <!-- Comparison -->
  <Section>
    <Container>
      <SectionHeader
        eyebrow="THE DIFFERENCE"
        title="Several AI tools, one shared conversation."
        description="AI chat apps are good at what they do. Syntila is for the moments when more than one person, or more than one AI provider, needs to be in the same conversation."
      />
      <ComparisonTable />
    </Container>
  </Section>

  <!-- Workflows -->
  <Section>
    <Container>
      <SectionHeader
        eyebrow="FOUR WAYS TO ASK"
        title="When a chat isn't enough: turn a question into a workflow."
        description="Most requests are a quick Chat. When you need more, choose a workflow that does the work, splits it across Workers, or checks its own result."
      />
      <WorkflowShowcase />
    </Container>
  </Section>

  <!-- Audiences -->
  <Section id="use-cases">
    <Container>
      <SectionHeader
        eyebrow="BUILT FOR EVERY GROUP"
        title="Designed for how people actually collaborate."
        description="Plan a family trip, make a product decision with your team, or ship reviewed code."
      />
      <AudienceCards />
    </Container>
  </Section>

  <!-- Plans -->
  <Section id="plans">
    <Container>
      <SectionHeader
        eyebrow="PLANS"
        title="Free to start."
        description="Syntila does not sell AI usage. Workers run on AI tools that members already have, so what you pay your AI provider stays between you and them."
      />
      <PlansOverview />
    </Container>
  </Section>

  <!-- Final CTA -->
  <Section class="final-cta-section">
    <Container>
      <div class="final-cta">
        <SectionHeader
          eyebrow="AI IS BETTER TOGETHER"
          title="Start with one Space."
          description="Open Syntila, create a Space, invite your people, and connect a computer to power its AI Workers."
        />
        <div class="final-cta__actions">
          <Button href="https://syntila.app" label="Open Syntila" event="cta.open_app" />
          <Button href="/downloads/" label="Download Workspace" variant="secondary" event="navigation.downloads" />
        </div>
      </div>
    </Container>
  </Section>
</SiteLayout>
