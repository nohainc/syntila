---
import Button from "../components/Button.astro";
import Container from "../components/Container.astro";
import Section from "../components/Section.astro";
import SectionHeader from "../components/SectionHeader.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Use Cases — Syntila"
  description="See how families, collaborative teams, and software engineers use Syntila to bring people and AI together."
>
  <Section>
    <Container>
      <SectionHeader
        eyebrow="Use cases"
        title="AI is better when you can use it together."
        description="Whether you're planning a family trip, analyzing market data with your team, or orchestrating code changes across repositories, Syntila brings people and AI into one shared workspace."
        headingLevel={1}
      />

      <nav class="usecase-jump-links" aria-label="Jump to use case">
        <a href="#family">Friends &amp; Family</a>
        <a href="#teams">Teams &amp; Companies</a>
        <a href="#engineering">Software &amp; Engineering</a>
      </nav>

      <!-- Section 1: Friends & Family -->
      <div id="family" class="usecase-detail-section">
        <div class="usecase-detail-header">
          <span class="usecase-badge usecase-badge--family">Friends &amp; Family</span>
          <h2>Think, plan, and decide together.</h2>
          <p class="usecase-intro">
            Stop sending screenshots of chatbot answers back and forth in messaging apps. One person connects a Syntila Workspace and grants AI Workers to the Space, and everyone else joins in the Syntila app across web, iOS, and Android to collaborate in context.
          </p>
        </div>

        <div class="usecase-grid">
          <div class="usecase-card">
            <span class="usecase-card-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.3c.4-.2.6-.6.5-1.1z"/></svg>
            </span>
            <h3>Vacation &amp; Travel Planning</h3>
            <p>Gather flight options, compare hotels and apartments, build day-by-day itineraries, and ask AI to compare transit options in one shared Thread.</p>
          </div>

          <div class="usecase-card">
            <span class="usecase-card-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            </span>
            <h3>Home &amp; Renovation Spaces</h3>
            <p>Compare contractor quotes, review material specifications, evaluate budget trade-offs, and keep decisions organized across separate Threads.</p>
          </div>

          <div class="usecase-card">
            <span class="usecase-card-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
            </span>
            <h3>Major Life &amp; Purchasing Decisions</h3>
            <p>Research schools, compare vehicles, analyze warranties, and ask different AI Workers for second opinions in the same conversation.</p>
          </div>

          <div class="usecase-card">
            <span class="usecase-card-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="7.5" cy="15.5" r="5.5"/><path d="m21 2-9.6 9.6"/><path d="m15.5 7.5 3 3L22 7l-3-3"/></svg>
            </span>
            <h3>Share AI access without sharing passwords</h3>
            <p>One member connects their AI subscription through Syntila Workspace so the whole group can use it in the Space—without sharing login passwords or API keys.</p>
          </div>
        </div>
      </div>

      <!-- Section 2: Teams & Companies -->
      <div id="teams" class="usecase-detail-section">
        <div class="usecase-detail-header">
          <span class="usecase-badge usecase-badge--teams">Teams &amp; Companies</span>
          <h2>Collaborative intelligence for knowledge work.</h2>
          <p class="usecase-intro">
            Give your product, marketing, operations, and leadership teams a shared AI workspace where discussions, prompts, multi-Worker research, and decisions stay in one place.
          </p>
        </div>

        <div class="usecase-grid">
          <div class="usecase-card">
            <span class="usecase-card-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><path d="m19 9-5 5-4-4-3 3"/></svg>
            </span>
            <h3>Market &amp; Competitive Research</h3>
            <p>Run the Research workflow preset so multiple AI Workers gather findings in parallel and synthesize them into a structured comparison.</p>
          </div>

          <div class="usecase-card">
            <span class="usecase-card-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z"/></svg>
            </span>
            <h3>Strategy &amp; Content Collaboration</h3>
            <p>Draft product specs, customer proposals, launch copy, and memos with team feedback and AI revisions in the same Thread.</p>
          </div>

          <div class="usecase-card">
            <span class="usecase-card-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 21h5v-5"/></svg>
            </span>
            <h3>Multi-Worker Deliberation</h3>
            <p>Compare answers from ChatGPT, Claude, and Google Gemini in the same Thread without losing context or repeating your prompt.</p>
          </div>

          <div class="usecase-card">
            <span class="usecase-card-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </span>
            <h3>Scoped Access &amp; Attribution</h3>
            <p>Assign Owner, Collaborator, or Viewer roles per Space, grant specific Workers to specific Spaces, and revoke Space grants when projects conclude.</p>
          </div>
        </div>
      </div>

      <!-- Section 3: Software & Engineering -->
      <div id="engineering" class="usecase-detail-section">
        <div class="usecase-detail-header">
          <span class="usecase-badge usecase-badge--dev">Software &amp; Engineering Teams</span>
          <h2>Turn discussions into verified code.</h2>
          <p class="usecase-intro">
            Connect your development machines and CLI coding agents through Syntila Workspace. Run structured workflows in your Space Work Directory with isolated sessions, Thread mutation leases, and test verification.
          </p>
        </div>

        <div class="usecase-grid">
          <div class="usecase-card">
            <span class="usecase-card-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            </span>
            <h3>Coding Agent Orchestration</h3>
            <p>Dispatch programming tasks to Codex CLI, Claude Code, Antigravity CLI, or custom MCP Workers running on an authorized Workspace with explicit Allowed Folders and pinned MCP tool servers.</p>
          </div>

          <div class="usecase-card">
            <span class="usecase-card-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
            </span>
            <h3>Coordinated Thread Execution</h3>
            <p>Collaborate across multiple Threads in a Space while exclusive Thread mutation leases serialize mutating steps in the Space Work Directory.</p>
          </div>

          <div class="usecase-card">
            <span class="usecase-card-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2v17.5c0 1.4-1.1 2.5-2.5 2.5s-2.5-1.1-2.5-2.5V2"/><path d="M8.5 2h7"/><path d="M9 16h6"/></svg>
            </span>
            <h3>Full Cycle Verification</h3>
            <p>Run Plan → Implement → Test → Verify workflows so implementation, automated test execution, and verification findings are recorded in the Thread.</p>
          </div>

          <div class="usecase-card">
            <span class="usecase-card-icon" aria-hidden="true">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="8" x="2" y="2" rx="2" ry="2"/><rect width="20" height="8" x="2" y="14" rx="2" ry="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/></svg>
            </span>
            <h3>Local Workspace Execution</h3>
            <p>Keep repository checkouts, build toolchains, and CLI credentials on your own macOS, Windows, or Linux machine while collaborating through Syntila Cloud.</p>
          </div>
        </div>
      </div>

      <!-- Bottom Action -->
      <div class="actions actions--center section-block-gap-lg">
        <Button href="https://syntila.app" label="Open Syntila" event="cta.open_app" />
        <Button href="/workers/" label="Explore AI &amp; Workers" variant="secondary" />
        <Button href="/how-it-works/" label="See how it works" variant="secondary" event="navigation.how_it_works" />
      </div>
    </Container>
  </Section>
</SiteLayout>

<style>
  .usecase-jump-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .usecase-jump-links a {
    display: inline-flex;
    align-items: center;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--border-subtle, rgba(128, 128, 128, 0.25));
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }

  .usecase-jump-links a:hover {
    border-color: currentColor;
  }
</style>
