---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Navigation from "../components/Navigation.astro";
import SiteAnalytics from "../components/SiteAnalytics.astro";

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image = "/social-preview.png" } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? "https://conclaveax.com").href;
const imageUrl = new URL(image, Astro.site ?? "https://conclaveax.com").href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#121217" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico?v=precision-indigo-20261029" sizes="32x32" />
    <link rel="icon" href="/syntila_logo_192.png?v=precision-indigo-20261029" type="image/png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/syntila_logo_192.png?v=precision-indigo-20261029" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Syntila" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Syntila — Bring your people and AI together in one shared space." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <title>{title}</title>
  </head>
  <body data-site-analytics-endpoint={import.meta.env.PUBLIC_SITE_ANALYTICS_ENDPOINT ?? ""}>
    <a class="skip-link visually-hidden" href="#main-content">Skip to main content</a>
    <Navigation currentPath={Astro.url.pathname} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <SiteAnalytics />
  </body>
</html>
