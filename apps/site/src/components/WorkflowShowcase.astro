---
// Component: WorkflowShowcase
// Visualizes multi-step AI orchestration pipelines for research/synthesis and engineering
---

<div class="workflow-showcase-container">
  <div class="workflow-tabs-header">
    <div class="workflow-intro-text">
      <strong>Choose Chat for direct answers, or structured Work presets for multi-step execution</strong>
      <span>Syntila coordinates each step across authorized Space Workers and records every intermediate result in the Thread.</span>
    </div>
  </div>

  <div class="workflow-pipeline-grid">
    <!-- Pipeline 1: Research & Synthesis Workflow -->
    <div class="pipeline-card">
      <div class="pipeline-card-header">
        <span class="pipeline-tag pipeline-tag--general">Research Workflow Preset</span>
        <h3>Multi-Worker Research & Synthesis</h3>
      </div>
      <div class="pipeline-steps">
        <div class="pipe-step">
          <div class="pipe-step-number">01</div>
          <div class="pipe-step-content">
            <strong>Parallel Research</strong>
            <span class="pipe-worker">Workers: Claude & Google Gemini</span>
            <p>Each selected research Worker independently investigates the topic, gathers evidence, and structures findings.</p>
          </div>
        </div>

        <div class="pipe-connector" aria-hidden="true">↓</div>

        <div class="pipe-step">
          <div class="pipe-step-number">02</div>
          <div class="pipe-step-content">
            <strong>Cross-Perspective Comparison</strong>
            <span class="pipe-worker">Shared Thread Context</span>
            <p>Syntila collects the prerequisite research outputs and assembles the full context package for synthesis.</p>
          </div>
        </div>

        <div class="pipe-connector" aria-hidden="true">↓</div>

        <div class="pipe-step">
          <div class="pipe-step-number">03</div>
          <div class="pipe-step-content">
            <strong>Unified Synthesis</strong>
            <span class="pipe-worker">Worker: ChatGPT</span>
            <p>Combines findings into a single structured summary with trade-offs, open questions, and recommended decisions.</p>
          </div>
        </div>
      </div>
      <div class="pipe-summary-footer">
        <span>✓ Parallel Worker perspectives</span>
        <span>✓ Shared Thread context</span>
        <span>✓ Inspectable step outputs</span>
      </div>
    </div>

    <!-- Pipeline 2: Full Cycle Engineering Workflow -->
    <div class="pipeline-card">
      <div class="pipeline-card-header">
        <span class="pipeline-tag pipeline-tag--dev">Full Cycle Workflow Preset</span>
        <h3>Plan, Implement, Test & Verify</h3>
      </div>
      <div class="pipeline-steps">
        <div class="pipe-step">
          <div class="pipe-step-number">01</div>
          <div class="pipe-step-content">
            <strong>Plan & Implement</strong>
            <span class="pipe-worker">Worker: Coding Agents (Codex / Claude Code CLI)</span>
            <p>Designs the change and edits files inside the Space Work Directory under an exclusive Thread mutation lease.</p>
          </div>
        </div>

        <div class="pipe-connector" aria-hidden="true">↓</div>

        <div class="pipe-step">
          <div class="pipe-step-number">02</div>
          <div class="pipe-step-content">
            <strong>Test Execution</strong>
            <span class="pipe-worker">Worker: Connected Syntila Workspace</span>
            <p>Runs the relevant test suite locally on the Workspace host and captures command output and exit status.</p>
          </div>
        </div>

        <div class="pipe-connector" aria-hidden="true">↓</div>

        <div class="pipe-step">
          <div class="pipe-step-number">03</div>
          <div class="pipe-step-content">
            <strong>Independent Verification</strong>
            <span class="pipe-worker">Worker: Verification Worker</span>
            <p>Reviews the implementation and test evidence against the original request before reporting completion to the Thread.</p>
          </div>
        </div>
      </div>
      <div class="pipe-summary-footer">
        <span>✓ Coordinated Thread lease</span>
        <span>✓ Executable test evidence</span>
        <span>✓ Independent verification step</span>
      </div>
    </div>
  </div>
</div>
