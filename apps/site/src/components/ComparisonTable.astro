---
// Component: ComparisonTable
// Compares using separate AI chat apps with a shared Syntila Space
---

<div class="comparison-container">
  <div class="comparison-table-wrapper">
    <table class="comparison-table">
      <caption class="visually-hidden">Using separate AI chat apps compared with a Syntila Space</caption>
      <thead>
        <tr>
          <th scope="col" class="th-feature">What you get</th>
          <th scope="col" class="th-traditional">Separate AI chat apps</th>
          <th scope="col" class="th-syntila">
            <span class="syntila-badge">Syntila</span>
          </th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <th scope="row" class="td-feature"><strong>AI providers</strong></th>
          <td class="td-traditional">One provider per app</td>
          <td class="td-syntila">
            <strong>Several providers in one Thread</strong>
            <small>ChatGPT, Claude, Gemini, or local models</small>
          </td>
        </tr>
        <tr>
          <th scope="row" class="td-feature"><strong>People</strong></th>
          <td class="td-traditional">Group features depend on the provider and the plan</td>
          <td class="td-syntila">
            <strong>Built around a group</strong>
            <small>Owner, Collaborator, and Viewer roles in every Space</small>
          </td>
        </tr>
        <tr>
          <th scope="row" class="td-feature"><strong>Context</strong></th>
          <td class="td-traditional">Each app keeps its own history</td>
          <td class="td-syntila">
            <strong>One shared Thread history</strong>
            <small>The next Worker continues where the last one stopped</small>
          </td>
        </tr>
        <tr>
          <th scope="row" class="td-feature"><strong>AI accounts</strong></th>
          <td class="td-traditional">Every person needs an account with every provider</td>
          <td class="td-syntila">
            <strong>Use what members already have</strong>
            <small>Within the terms of each provider plan</small>
          </td>
        </tr>
        <tr>
          <th scope="row" class="td-feature"><strong>Where it runs</strong></th>
          <td class="td-traditional">In the provider's cloud</td>
          <td class="td-syntila">
            <strong>On a member's own computer</strong>
            <small>Next to their files, tools, and projects</small>
          </td>
        </tr>
        <tr>
          <th scope="row" class="td-feature"><strong>Bigger tasks</strong></th>
          <td class="td-traditional">Varies by app</td>
          <td class="td-syntila">
            <strong>Research and Implement workflows</strong>
            <small>Multi-step runs with recorded results</small>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
