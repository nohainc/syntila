{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "syntila-site",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true,
  },
  "services": [
    { "binding": "LEGACY_AUTH", "service": "syntila-app" },
  ],
  "routes": [
    { "pattern": "syntila.app", "custom_domain": true },
    { "pattern": "www.syntila.app", "custom_domain": true },
    {
      "pattern": "conclaveax.com",
      "custom_domain": true,
    },
    {
      "pattern": "www.conclaveax.com",
      "custom_domain": true,
    },
  ],
}
