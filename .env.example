# Shared local-development defaults. Secrets belong in .dev.vars or the CI secret store.
SYNTILA_ENVIRONMENT=development
SYNTILA_API_BASE_URL=http://localhost:8787
# Optional local Paddle sandbox checkout configuration. These settings are only
# accepted when SYNTILA_ENVIRONMENT=development. The reference secret must be
# at least 32 characters and must differ from every production secret.
# PADDLE_SANDBOX_CLIENT_TOKEN=test_...
# PADDLE_SANDBOX_MONTHLY_PRICE_ID=pri_...
# PADDLE_SANDBOX_ANNUAL_PRICE_ID=pri_...
# PADDLE_SANDBOX_REFERENCE_SECRET=
# PADDLE_SANDBOX_WEBHOOK_SECRET=
# PADDLE_SANDBOX_API_KEY=

# Live billing preparation (backend deployment environment only). Keep checkout
# disabled until the production webhook and fulfillment path are implemented
# and verified. Do not copy sandbox secrets into production.
# PADDLE_LIVE_CHECKOUT_ENABLED=false
# PADDLE_LIVE_CLIENT_TOKEN=live_...
# PADDLE_LIVE_MONTHLY_PRICE_ID=pri_...
# PADDLE_LIVE_ANNUAL_PRICE_ID=pri_...
# PADDLE_LIVE_REFERENCE_SECRET=
