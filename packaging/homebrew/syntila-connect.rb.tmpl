class SyntilaConnect < Formula
  desc "Runs your Syntila Workers on this computer"
  homepage "https://syntila.app"
  version "@VERSION@"
  license :cannot_represent

  depends_on arch: :arm64
  depends_on :macos

  url "@URL@"
  sha256 "@SHA256@"

  def install
    bin.install "syntila-connect", "syntila-worker"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/syntila-connect version")
  end
end
