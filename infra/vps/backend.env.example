NODE_ENV=production
BIND_HOST=127.0.0.1
PORT=3000
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=syntila_app
PGDATABASE=syntila
PG_POOL_MAX=20
AUTH_JWT_ISSUER=https://syntila.app
AUTH_JWT_AUDIENCE=syntila-backend
# Comma-separated browser origins allowed for CORS and WebSocket upgrades.
ALLOWED_ORIGINS=https://syntila.app
SYNTILA_ENVIRONMENT=production
SYNTILA_APP_URL=https://syntila.app
# Object storage (R2 S3 API); leave empty until slice 7.x needs it
R2_ACCOUNT_ID=
R2_BUCKET=syntila-artifacts-production
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Email relay on the Cloudflare auth Worker (Phase 8)
EMAIL_RELAY_URL=
EMAIL_RELAY_SECRET=
# Workspace application releases (publish/verify update metadata)
SYNTILA_RELEASE_PUBLISHER=
SYNTILA_RELEASE_TRUST_KEYS_JSON=
# Profile Lab admin is restricted to this account
SYNTILA_PROFILE_LAB_OWNER_EMAIL=vitalii@nohainc.com
