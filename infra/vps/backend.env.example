NODE_ENV=production
BIND_HOST=127.0.0.1
PORT=3000
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=syntila_app
PGDATABASE=syntila
PG_POOL_MAX=20
AUTH_JWT_ISSUER=https://syntila.app
AUTH_JWT_AUDIENCE=syntila-backend
# Comma-separated browser origins allowed for CORS and WebSocket upgrades.
ALLOWED_ORIGINS=https://syntila.app,https://app.syntila.app
SYNTILA_ENVIRONMENT=production
SYNTILA_APP_URL=https://app.syntila.app
# Object storage (R2 S3 API); leave empty until slice 7.x needs it
R2_ACCOUNT_ID=
R2_BUCKET=syntila-artifacts-production
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Email relay on the Cloudflare auth Worker (Phase 8)
EMAIL_RELAY_URL=
EMAIL_RELAY_SECRET=
# Workspace application releases (publish/verify update metadata)
SYNTILA_RELEASE_PUBLISHER=
SYNTILA_RELEASE_TRUST_KEYS_JSON=
# Profile Lab admin is restricted to this account
SYNTILA_PROFILE_LAB_OWNER_EMAIL=vitalii@nohainc.com

# Request limits per caller per minute (0 disables). Defaults: 3000 requests,
# 600 mutations. Connected Workspace traffic and realtime are exempt.
# Set both to 0 for load tests.
#SYNTILA_RATE_LIMIT_PER_MINUTE=3000
#SYNTILA_MUTATION_RATE_LIMIT_PER_MINUTE=600

# Emergency fallback only: every write takes one global writer lock again
# (the pre-concurrency-plan behaviour). Restart the backend after changing it.
# SYNTILA_DB_WRITER_LOCK=on
