NODE_ENV=production
BIND_HOST=127.0.0.1
PORT=3000
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=syntila_app
PGDATABASE=syntila
PG_POOL_MAX=20
# A statement waiting this long for a lock fails and the API answers 503 busy
# (the app retries once). A session idle inside a transaction is terminated
# after the second limit, which frees any locks it held. Defaults shown.
#PG_LOCK_TIMEOUT_MS=10000
#PG_IDLE_TX_TIMEOUT_MS=30000
AUTH_JWT_ISSUER=https://syntila.app
AUTH_JWT_AUDIENCE=syntila-backend
# Comma-separated browser origins allowed for CORS and WebSocket upgrades.
ALLOWED_ORIGINS=https://syntila.app,https://app.syntila.app
SYNTILA_ENVIRONMENT=production
SYNTILA_APP_URL=https://app.syntila.app
# Object storage (R2 S3 API); leave empty until slice 7.x needs it
R2_ACCOUNT_ID=
R2_BUCKET=syntila-artifacts-production
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Email relay on the Cloudflare auth Worker (Phase 8)
EMAIL_RELAY_URL=
EMAIL_RELAY_SECRET=
# Connect application releases (publish/verify update metadata)
SYNTILA_RELEASE_PUBLISHER=
SYNTILA_RELEASE_TRUST_KEYS_JSON=
# Profile signing: provision the private JWK as a secret; it must match Connect trust roots.
SYNTILA_PROFILE_SIGNING_KEY_ID=
SYNTILA_PROFILE_SIGNING_JWK=
# Profile Lab admin is restricted to this account
SYNTILA_PROFILE_LAB_OWNER_EMAIL=vitalii@nohainc.com

# Request limits per caller per minute (0 disables). Defaults: 3000 requests,
# 600 mutations. Connect traffic and realtime are exempt.
# Set both to 0 for load tests.
#SYNTILA_RATE_LIMIT_PER_MINUTE=3000
#SYNTILA_MUTATION_RATE_LIMIT_PER_MINUTE=600

# Optional flags (comma-separated, off by default). Every node of a cluster
# must use the same value. See docs/operations/FEATURE_FLAGS.md.
#SYNTILA_FEATURE_FLAGS=cluster_mode
