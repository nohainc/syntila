# Syntila monitor configuration (/etc/syntila/monitor.env). Configure at least one alert channel.

# ntfy (easiest: install the ntfy app on your phone and subscribe to the same topic).
# Use a long random topic name; anyone who knows it can read the alerts.
ALERT_NTFY_URL=
ALERT_NTFY_TOKEN=

# Slack incoming webhook
ALERT_SLACK_WEBHOOK=

# Telegram bot
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# Dead-man's switch (e.g. https://hc-ping.com/<uuid> from healthchecks.io).
# Pinged every 5 minutes; the external service alerts you when pings stop (VPS down).
HEARTBEAT_URL=

# Thresholds
DISK_WARN_PCT=80
DISK_CRIT_PCT=90
MEM_MIN_AVAILABLE_PCT=10
TLS_MIN_DAYS=14
DUMP_MAX_AGE_HOURS=26
REMIND_HOURS=6
