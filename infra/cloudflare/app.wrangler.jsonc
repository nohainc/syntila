{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Production auth Worker on syntila.app: Better Auth, desktop sign-in,
  // backend tokens, the email relay and the web app. The product API runs on
  // the VPS backend (SYNTILA_BACKEND_URL).
  "name": "syntila-app",
  "main": "../../apps/cloud/src/index.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat"],
  "triggers": {
    // Daily: prune ended auth sessions.
    "crons": ["17 3 * * *"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "assets": {
    "directory": "../../apps/app/build/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/health"],
  },
  "send_email": [
    {
      "name": "SYNTILA_EMAIL",
    },
  ],
  "vars": {
    "SYNTILA_PROFILE_LAB_OWNER_EMAIL": "vitalii@nohainc.com",
    "SYNTILA_ENVIRONMENT": "production",
    "BETTER_AUTH_URL": "https://syntila.app",
    "SYNTILA_APP_URL": "https://syntila.app",
    "SYNTILA_BACKEND_URL": "https://api.syntila.app",
    "SYNTILA_EMAIL_FROM": "syntila@conclaveax.com",
    "SYNTILA_EMAIL_FALLBACK_FROM": "vitalii@conclaveax.com",
    "SYNTILA_EMAIL_FROM_NAME": "Syntila",
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "SYNTILA_BACKEND_SIGNING_KEY", "EMAIL_RELAY_SECRET"],
  },
  "d1_databases": [
    {
      "binding": "SYNTILA_DB",
      // Auth-only database (accounts and sign-in state). Created for Phase 8.
      "database_name": "syntila-auth",
      "database_id": "ced1ca95-bd74-4ae3-9e65-2ccaddc0f3ce",
      "migrations_dir": "../../apps/cloud/migrations",
    },
  ],
  "migrations": [
    {
      "tag": "v1-runtime-connection",
      "new_sqlite_classes": ["RuntimeConnection", "AgentGateway"],
    },
    {
      "tag": "v2-host-and-realtime-gateway",
      "deleted_classes": ["RuntimeConnection", "AgentGateway"],
      "new_sqlite_classes": ["HostGateway", "RealtimeGateway"],
    },
    {
      "tag": "v3-workspace-and-realtime-gateway",
      "deleted_classes": ["HostGateway"],
      "new_sqlite_classes": ["WorkspaceGateway"],
    },
    {
      // Applied production history must retain its original class and tag.
      "tag": "v8-workstream-coordinator",
      "new_sqlite_classes": ["WorkstreamExecutionCoordinator"],
    },
    {
      "tag": "v9-thread-coordinator-rename",
      "renamed_classes": [
        {
          "from": "WorkstreamExecutionCoordinator",
          "to": "ThreadExecutionCoordinator",
        },
      ],
    },
    {
      // The gateways and coordinator now run in the VPS backend.
      "tag": "v10-moved-to-vps",
      "deleted_classes": ["WorkspaceGateway", "RealtimeGateway", "ThreadExecutionCoordinator"],
    },
  ],
  "routes": [
    {
      "pattern": "syntila.app",
      "custom_domain": true,
    },
  ],
}
